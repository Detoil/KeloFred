<?xml version="1.0" encoding="utf-8"?>
<!-- The Gizwits cloud is HTTPS. Cleartext is allowed so "My server" mode can
     reach a keloray-control server on your home network over plain http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
